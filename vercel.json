{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/site/index.html"
    },
    {
      "source": "/styles.css",
      "destination": "/site/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "/site/app.js"
    },
    {
      "source": "/comm.js",
      "destination": "/site/comm.js"
    },
    {
      "source": "/voice.js",
      "destination": "/site/voice.js"
    },
    {
      "source": "/(.*)",
      "destination": "/site/$1"
    }
  ]
}

